{
  "$defs": {
    "ClipSection": {
      "additionalProperties": false,
      "properties": {
        "clips_per_video": {
          "$ref": "#/$defs/ClipsPerVideo"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sampling": {
          "enum": [
            "uniform",
            "consecutive",
            "random-window"
          ],
          "title": "Sampling",
          "type": "string"
        },
        "stride": {
          "default": 1,
          "minimum": 1,
          "title": "Stride",
          "type": "integer"
        }
      },
      "required": [
        "frames",
        "sampling",
        "clips_per_video"
      ],
      "title": "ClipSection",
      "type": "object"
    },
    "ClipsPerVideo": {
      "additionalProperties": false,
      "properties": {
        "eval": {
          "minimum": 1,
          "title": "Eval",
          "type": "integer"
        },
        "train": {
          "minimum": 1,
          "title": "Train",
          "type": "integer"
        }
      },
      "required": [
        "train",
        "eval"
      ],
      "title": "ClipsPerVideo",
      "type": "object"
    },
    "ComponentSpec": {
      "additionalProperties": true,
      "description": "A pluggable component: ``{name: <registry key>, **params}``.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ComponentSpec",
      "type": "object"
    },
    "DataSection": {
      "additionalProperties": false,
      "properties": {
        "allow_input_mismatch": {
          "default": false,
          "title": "Allow Input Mismatch",
          "type": "boolean"
        },
        "clip": {
          "$ref": "#/$defs/ClipSection"
        },
        "labels": {
          "title": "Labels",
          "type": "string"
        },
        "loader": {
          "$ref": "#/$defs/LoaderSection"
        },
        "pairs": {
          "default": false,
          "title": "Pairs",
          "type": "boolean"
        },
        "processing": {
          "title": "Processing",
          "type": "string"
        },
        "test": {
          "oneOf": [
            {
              "$ref": "#/$defs/SuiteRef"
            },
            {
              "items": {
                "$ref": "#/$defs/DataSource"
              },
              "type": "array"
            }
          ],
          "title": "Test"
        },
        "train": {
          "items": {
            "$ref": "#/$defs/DataSource"
          },
          "minItems": 1,
          "title": "Train",
          "type": "array"
        },
        "transforms": {
          "$ref": "#/$defs/TransformsSection"
        },
        "val": {
          "items": {
            "$ref": "#/$defs/DataSource"
          },
          "title": "Val",
          "type": "array"
        }
      },
      "required": [
        "processing",
        "clip",
        "labels",
        "train",
        "loader"
      ],
      "title": "DataSection",
      "type": "object"
    },
    "DataSource": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "where": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Where",
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "split"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "EarlyStopSection": {
      "additionalProperties": false,
      "description": "Stop once the monitor has gone ``patience`` validations without improving by more than\n``min_delta``.",
      "properties": {
        "min_delta": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Delta",
          "type": "number"
        },
        "patience": {
          "minimum": 1,
          "title": "Patience",
          "type": "integer"
        }
      },
      "required": [
        "patience"
      ],
      "title": "EarlyStopSection",
      "type": "object"
    },
    "EvalSection": {
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "title": "Aggregate",
          "type": "string"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "metrics",
        "aggregate"
      ],
      "title": "EvalSection",
      "type": "object"
    },
    "InputOverrides": {
      "additionalProperties": false,
      "description": "``model.input``: overrides of the backbone's own input spec (the detector contract's\n``InputSpec``).\n\nOnly the keys written here override; every other one keeps the backbone's value. So the\nresolved config keeps exactly the keys that were written, and ``crop_scale: null`` (any crop\nscale the store kept, e.g. for a full-frame input) stays distinct from leaving it out.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "enum": [
                "rgb",
                "bgr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "crop": {
          "anyOf": [
            {
              "enum": [
                "face",
                "full-frame"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop"
        },
        "crop_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Scale"
        },
        "frames": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames"
        },
        "mean": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "modality": {
          "anyOf": [
            {
              "enum": [
                "frames",
                "audio",
                "audiovisual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality"
        },
        "preferred_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Profile"
        },
        "sampling": {
          "anyOf": [
            {
              "enum": [
                "uniform",
                "consecutive",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling"
        },
        "size": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "std": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        },
        "value_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Range"
        }
      },
      "title": "InputOverrides",
      "type": "object"
    },
    "LoaderSection": {
      "additionalProperties": false,
      "properties": {
        "balance": {
          "anyOf": [
            {
              "enum": [
                "none",
                "video-label",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance"
        },
        "batch_size": {
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "num_workers": {
          "minimum": 0,
          "title": "Num Workers",
          "type": "integer"
        }
      },
      "required": [
        "batch_size",
        "num_workers"
      ],
      "title": "LoaderSection",
      "type": "object"
    },
    "ModelSection": {
      "additionalProperties": false,
      "properties": {
        "backbone": {
          "$ref": "#/$defs/ComponentSpec"
        },
        "head": {
          "$ref": "#/$defs/ComponentSpec"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputOverrides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stem": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal_pool": {
          "$ref": "#/$defs/ComponentSpec"
        }
      },
      "required": [
        "backbone",
        "temporal_pool",
        "head"
      ],
      "title": "ModelSection",
      "type": "object"
    },
    "RunSection": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Root"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        }
      },
      "required": [
        "name",
        "seeds"
      ],
      "title": "RunSection",
      "type": "object"
    },
    "SuiteRef": {
      "additionalProperties": false,
      "properties": {
        "suite": {
          "title": "Suite",
          "type": "string"
        }
      },
      "required": [
        "suite"
      ],
      "title": "SuiteRef",
      "type": "object"
    },
    "TrainConfig": {
      "additionalProperties": false,
      "description": "``schema: dfwb.train/1``: one training experiment.",
      "properties": {
        "data": {
          "$ref": "#/$defs/DataSection"
        },
        "eval": {
          "$ref": "#/$defs/EvalSection"
        },
        "loss": {
          "$ref": "#/$defs/ComponentSpec"
        },
        "model": {
          "$ref": "#/$defs/ModelSection"
        },
        "optim": {
          "$ref": "#/$defs/ComponentSpec"
        },
        "run": {
          "$ref": "#/$defs/RunSection"
        },
        "schedule": {
          "$ref": "#/$defs/ComponentSpec"
        },
        "schema": {
          "const": "dfwb.train/1",
          "title": "Schema",
          "type": "string"
        },
        "train": {
          "$ref": "#/$defs/TrainSection"
        }
      },
      "required": [
        "schema",
        "run",
        "data",
        "model",
        "loss",
        "optim",
        "schedule",
        "train",
        "eval"
      ],
      "title": "TrainConfig",
      "type": "object"
    },
    "TrainSection": {
      "additionalProperties": false,
      "properties": {
        "callbacks": {
          "items": {
            "$ref": "#/$defs/ComponentSpec"
          },
          "title": "Callbacks",
          "type": "array"
        },
        "devices": {
          "minimum": 1,
          "title": "Devices",
          "type": "integer"
        },
        "early_stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarlyStopSection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heartbeat_steps": {
          "default": 50,
          "minimum": 1,
          "title": "Heartbeat Steps",
          "type": "integer"
        },
        "lightning": {
          "additionalProperties": true,
          "title": "Lightning",
          "type": "object"
        },
        "loggers": {
          "items": {
            "enum": [
              "csv",
              "tensorboard",
              "wandb"
            ],
            "type": "string"
          },
          "title": "Loggers",
          "type": "array"
        },
        "max_epochs": {
          "minimum": 1,
          "title": "Max Epochs",
          "type": "integer"
        },
        "mode": {
          "default": "max",
          "enum": [
            "max",
            "min"
          ],
          "title": "Mode",
          "type": "string"
        },
        "monitor": {
          "default": "val/video_auc",
          "title": "Monitor",
          "type": "string"
        },
        "nan_tolerance": {
          "default": 3,
          "minimum": 1,
          "title": "Nan Tolerance",
          "type": "integer"
        },
        "precision": {
          "default": "auto",
          "enum": [
            "auto",
            "32-true",
            "bf16-mixed",
            "16-mixed"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "max_epochs",
        "devices"
      ],
      "title": "TrainSection",
      "type": "object"
    },
    "TransformsSection": {
      "additionalProperties": false,
      "properties": {
        "train": {
          "items": {
            "$ref": "#/$defs/ComponentSpec"
          },
          "title": "Train",
          "type": "array"
        }
      },
      "title": "TransformsSection",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dfwb C2: Config (schema dfwb.train/1)",
  "x-dfwb-contract": {
    "id": "c2",
    "version": "dfwb.train/1"
  }
}
