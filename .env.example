# Per-machine settings for DFWB. `scripts/setup.sh` copies this file to `.env` for you (and
# never overwrites an existing one); copy it by hand if you skip that script. `.env` is
# git-ignored: it is never committed, because it names real paths on one machine.
#
# `dfwb` loads `.env` itself, explicitly, before any subcommand runs (see `dfwb doctor` and
# `dfwb --env-file` / `--no-env-file`). Values already set in the real environment always win
# over `.env`; `.env` only fills in what is not already set. A relative path set here resolves
# against the directory this `.env` file lives in (the clone), not against wherever you happen
# to run `dfwb` from.
#
# The defaults below keep every root inside the clone, git-ignored: datasets, work and cache
# under `data/`, and training runs (and the score files written next to them) in `runs/`, where
# the README and the guides look for them. A fresh clone is ready to run the toyfake benchmark
# with nothing to configure. Point them at real storage instead once you outgrow that -- see the
# commented-out multi-root example below.

# Where raw datasets live.
DFWB_DATASETS_ROOT=./data/datasets

# Where DFWB writes everything it derives (inventories, packs, clips, runs).
DFWB_WORK_ROOT=./data/work

# Where training runs are written, and `dfwb score`'s score files under `scores/`.
DFWB_RUNS_ROOT=./runs

# Where downloaded/cached artefacts (weights, plugin metadata, ...) are kept.
DFWB_CACHE_ROOT=./data/cache

# Several datasets roots may be listed, separated by `:` (searched in order, first match wins);
# this is how one machine looks in more than one storage location, e.g. real data kept outside
# the clone. Replace the default DFWB_DATASETS_ROOT line above with something like:
# DFWB_DATASETS_ROOT=/data/datasets:/nfs/datasets

# Point one dataset id at a folder outside every DFWB_DATASETS_ROOT (or under a different name).
# The id is upper-cased with `-` turned into `_`, e.g. celebdf-v2 -> DFWB_DATASET_CELEBDF_V2.
# DFWB_DATASET_CELEBDF_V2=/archive/CelebDF-v2-mirror

# Override the host name DFWB uses to pick [hosts.<name>] tables in dfwb.toml / config.toml,
# instead of the machine's real hostname.
# DFWB_HOST=gpu-node-1
